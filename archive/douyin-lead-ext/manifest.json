{
  "manifest_version": 3,
  "name": "抖音获客采集助手",
  "version": "0.4.0",
  "description": "打开抖音视频页面，自动采集评论区意向客户线索（昵称、抖音号、粉丝数、评论、属地等），按关键词过滤、去重，一键导出 Excel",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "抖音获客采集助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.douyin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
